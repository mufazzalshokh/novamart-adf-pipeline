{
  "name": "ls_adls_kv",
  "properties": {
    "annotations": ["NMDP-101", "Secret from Key Vault"],
    "parameters": {
      "keyVaultUrl": {
        "type": "String",
        "defaultValue": "https://kv-novamart-dev.vault.azure.net/"
      },
      "secretName": {
        "type": "String",
        "defaultValue": "adls-connection-string"
      }
    },
    "type": "AzureBlobStorage",
    "typeProperties": {
      "connectionString": {
        "type": "AzureKeyVaultSecret",
        "store": {
          "referenceName": "ls_keyvault",
          "type": "LinkedServiceReference",
          "parameters": {
            "baseUrl": "@linkedService().keyVaultUrl"
          }
        },
        "secretName": "@linkedService().secretName"
      }
    }
  }
}
